@model CinemaBookingSystem.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    Layout = "_Layout";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="History">My Orders</a></li>
            <li class="breadcrumb-item active">Order #@Model.Id</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Order #@Model.Id</h2>
        <span class="badge fs-6 @(Model.Status == CinemaBookingSystem.Models.OrderStatus.Completed ? "bg-success" :
                                   Model.Status == CinemaBookingSystem.Models.OrderStatus.Confirmed ? "bg-primary" :
                                   Model.Status == CinemaBookingSystem.Models.OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
            @Model.Status
        </span>
    </div>

    <div class="row g-4">
        <!-- 左侧：电影票详情 -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-ticket-perforated me-2"></i>Ticket Details</h5>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light">
                            <tr><th>Movie</th><th>Date</th><th>Time</th><th>Hall</th><th class="text-center">Qty</th><th class="text-end">Amount</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="fw-bold">@item.MovieTitle</td>
                                    <td>@item.ShowDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.ShowTime.ToString(@"hh\:mm")</td>
                                    <td>@item.Hall</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">RM @item.SubTotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-bold">Total:</td>
                                <td class="text-end fw-bold text-primary">RM @Model.TotalAmount.ToString("F2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- 右侧：订单信息与 QR Code -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Order Info</h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <dl class="row mb-0">
                        <dt class="col-5">Order Date</dt>
                        <dd class="col-7">@Model.OrderDate.ToString("dd MMM yyyy HH:mm")</dd>
                        <dt class="col-5">Contact</dt>
                        <dd class="col-7">@Model.ContactName</dd>
                        <dt class="col-5">Phone</dt>
                        <dd class="col-7">@Model.ContactPhone</dd>
                        <dt class="col-5">Email</dt>
                        <dd class="col-7 text-truncate">@Model.ContactEmail</dd>
                        <dt class="col-5">Payment</dt>
                        <dd class="col-7">@Model.PaymentMethod</dd>
                        <dt class="col-5">Pay Status</dt>
                        <dd class="col-7">
                            <span class="badge @(Model.PaymentStatus == CinemaBookingSystem.Models.PaymentStatus.Paid ? "bg-success" : "bg-secondary")">@Model.PaymentStatus</span>
                        </dd>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <dt class="col-5">Notes</dt>
                            <dd class="col-7">@Model.Notes</dd>
                        }
                    </dl>

                    <!-- 分割线与 QR Code 区域 -->
                    <hr class="my-4" />
                    <div class="text-center mt-auto">
                        <p class="text-muted small mb-2 fw-semibold"><i class="bi bi-qr-code-scan me-1"></i>Scan for Entry</p>
                        <div id="qrcode" class="d-inline-block p-2 bg-white border rounded shadow-sm"></div>
                        <p class="text-muted small mt-2 mb-0">Ticket ID: #@Model.Id</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="History" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>Back to Orders
        </a>
    </div>
</div>

@section Scripts {
    <!-- 引入生成 QR Code 的轻量级库 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 设置 QR Code 里面包含的内容，例如: "CINEMAX-ORDER-12345"
            var qrContent = "CINEMAX-ORDER-" + "@Model.Id"; 
            
            // 生成二维码
            var qrcode = new QRCode(document.getElementById("qrcode"), {
                text: qrContent,
                width: 140, // 调整大小
                height: 140,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        });
    </script>
}