@model CinemaBookingSystem.Models.Movie
@{
    ViewData["Title"] = "Delete Movie";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-danger"><i class="bi bi-trash me-2"></i>Delete Movie</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:550px">
    <div class="card-header bg-danger text-white">
        <i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion
    </div>
    <div class="card-body">
        <div class="d-flex gap-3 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.Title" class="rounded" style="width:80px;height:110px;object-fit:cover;" />
            }
            <div>
                <h5 class="fw-bold">@Model.Title</h5>
                <p class="text-muted mb-1">@Model.Category?.Name | @Model.Duration min | @Model.Rating</p>
                <p class="text-muted small mb-0">Director: @Model.Director</p>
            </div>
        </div>
        <p>Are you sure you want to permanently delete this movie? This action cannot be undone.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete Movie</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
