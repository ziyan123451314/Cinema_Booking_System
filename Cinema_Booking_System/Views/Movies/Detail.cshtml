@model CinemaBookingSystem.Models.Movie
@{
    ViewData["Title"] = Model.Title;
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-film me-2 text-primary"></i>Movie Detail</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded-3 shadow w-100" style="max-height:400px;object-fit:cover;" />
        }
        else
        {
            <div class="bg-secondary rounded-3 d-flex align-items-center justify-content-center" style="height:350px;">
                <i class="bi bi-film display-1 text-white"></i>
            </div>
        }
    </div>
    <div class="col-md-8">
        <h3 class="fw-bold">@Model.Title</h3>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-primary">@Model.Category?.Name</span>
            <span class="badge bg-dark">@Model.Rating</span>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
        </div>
        <dl class="row">
            <dt class="col-4">Director</dt><dd class="col-8">@(Model.Director ?? "-")</dd>
            <dt class="col-4">Cast</dt><dd class="col-8">@(Model.Cast ?? "-")</dd>
            <dt class="col-4">Genre</dt><dd class="col-8">@(Model.Genre ?? "-")</dd>
            <dt class="col-4">Language</dt><dd class="col-8">@(Model.Language ?? "-")</dd>
            <dt class="col-4">Duration</dt><dd class="col-8">@Model.Duration minutes</dd>
            <dt class="col-4">Base Price</dt><dd class="col-8 fw-bold text-primary">RM @Model.Price.ToString("F2")</dd>
            <dt class="col-4">Release Date</dt><dd class="col-8">@(Model.ReleasedAt?.ToString("dd MMM yyyy") ?? "-")</dd>
            <dt class="col-4">Created</dt><dd class="col-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>
        <p class="mt-2">@Model.Description</p>
    </div>
</div>

<!-- Showtimes -->
<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Showtimes (@Model.Showtimes.Count)</h5>
        <a href="/Admin/Showtimes/Create?movieId=@Model.Id" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus me-1"></i>Add Showtime
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr><th>Date</th><th>Time</th><th>Hall</th><th>Available / Total</th><th>Price</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Showtimes.OrderBy(s => s.ShowDate).ThenBy(s => s.ShowTime))
                {
                    <tr>
                        <td>@s.ShowDate.ToString("dd MMM yyyy")</td>
                        <td>@s.ShowTime.ToString(@"hh\:mm")</td>
                        <td>@s.Hall</td>
                        <td>@s.AvailableSeats / @s.TotalSeats</td>
                        <td>RM @s.Price.ToString("F2")</td>
                        <td><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Active" : "Off")</span></td>
                    </tr>
                }
                @if (!Model.Showtimes.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No showtimes.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
