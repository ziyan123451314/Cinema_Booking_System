@model IEnumerable<CinemaBookingSystem.Models.Showtime>
@{
    ViewData["Title"] = "Showtime Management";
    Layout = "_AdminLayout";
    var movies = ViewBag.Movies as IEnumerable<CinemaBookingSystem.Models.Movie>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Showtime Management</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Showtime</a>
</div>

<!-- Filter by movie -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end" style="max-width:500px">
        <div class="col">
            <label class="form-label fw-semibold">Filter by Movie</label>
            <select name="movieId" class="form-select">
                <option value="">All Movies</option>
                @if (movies != null)
                {
                    @foreach (var m in movies)
                    {
                        <option value="@m.Id" selected="@(ViewBag.MovieFilter?.ToString() == m.Id.ToString())">@m.Title</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle table-hover">
                <thead class="table-dark">
                    <tr><th>Movie</th><th>Date</th><th>Time</th><th>Hall</th><th class="text-center">Seats</th><th class="text-end">Price</th><th class="text-center">Status</th><th class="text-center">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Movie?.Title</td>
                            <td>@s.ShowDate.ToString("dd MMM yyyy")</td>
                            <td>@s.ShowTime.ToString(@"hh\:mm")</td>
                            <td>@s.Hall</td>
                            <td class="text-center">
                                <span class="@(s.AvailableSeats == 0 ? "text-danger" : s.AvailableSeats <= 20 ? "text-warning" : "text-success") fw-bold">
                                    @s.AvailableSeats
                                </span> / @s.TotalSeats
                            </td>
                            <td class="text-end">RM @s.Price.ToString("F2")</td>
                            <td class="text-center"><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this showtime?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No showtimes found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
