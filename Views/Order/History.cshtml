@model CinemaBookingSystem.Models.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Order History";
    Layout = "_Layout";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-clock-history me-2 text-primary"></i>Order History</h2>

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt display-1 text-muted"></i>
            <p class="mt-3 text-muted fs-5">You haven't placed any orders yet.</p>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-warning mt-2">
                <i class="bi bi-film me-2"></i>Start Booking
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th class="text-center">Items</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Payment</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td class="fw-bold">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-center">@order.OrderItems.Count</td>
                                    <td class="text-end fw-bold">RM @order.TotalAmount.ToString("F2")</td>
                                    <td class="text-center">
                                        <span class="badge @(order.Status == CinemaBookingSystem.Models.OrderStatus.Completed ? "bg-success" :
                                                             order.Status == CinemaBookingSystem.Models.OrderStatus.Confirmed ? "bg-primary" :
                                                             order.Status == CinemaBookingSystem.Models.OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(order.PaymentStatus == CinemaBookingSystem.Models.PaymentStatus.Paid ? "bg-success" :
                                                             order.PaymentStatus == CinemaBookingSystem.Models.PaymentStatus.Refunded ? "bg-info" : "bg-secondary")">
                                            @order.PaymentStatus
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
