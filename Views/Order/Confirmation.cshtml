@model CinemaBookingSystem.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="display-1 text-success mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="fw-bold">Booking Confirmed!</h1>
        <p class="lead text-muted">Thank you for booking with CineMax. Your order has been received.</p>
        <div class="badge bg-primary fs-5 px-4 py-2">Order #@Model.Id</div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-ticket-perforated me-2"></i>Your Tickets</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Movie</th>
                                    <th>Date & Time</th>
                                    <th>Hall</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.MovieTitle</td>
                                        <td>@item.ShowDate.ToString("dd MMM yyyy") @item.ShowTime.ToString(@"hh\:mm")</td>
                                        <td>@item.Hall</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">RM @item.SubTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="fw-bold text-end">Total:</td>
                                    <td class="text-end fw-bold text-primary fs-5">RM @Model.TotalAmount.ToString("F2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <p class="mb-1"><strong>Contact:</strong> @Model.ContactName</p>
                            <p class="mb-1"><strong>Phone:</strong> @Model.ContactPhone</p>
                            <p class="mb-0"><strong>Email:</strong> @Model.ContactEmail</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>
                            <p class="mb-1"><strong>Payment Status:</strong>
                                <span class="badge @(Model.PaymentStatus == CinemaBookingSystem.Models.PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">
                                    @Model.PaymentStatus
                                </span>
                            </p>
                            <p class="mb-0"><strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a asp-action="History" class="btn btn-outline-primary">
                    <i class="bi bi-clock-history me-2"></i>My Orders
                </a>
                <a asp-controller="Movie" asp-action="Index" class="btn btn-warning">
                    <i class="bi bi-film me-2"></i>Browse More Movies
                </a>
            </div>
        </div>
    </div>
</div>
