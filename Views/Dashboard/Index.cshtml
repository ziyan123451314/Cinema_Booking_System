@model CinemaBookingSystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<h2 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h2>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-people-fill display-4"></i>
                <div>
                    <div class="fs-1 fw-bold lh-1">@Model.TotalMembers</div>
                    <div class="small opacity-75">Registered Members</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-film display-4"></i>
                <div>
                    <div class="fs-1 fw-bold lh-1">@Model.TotalMovies</div>
                    <div class="small opacity-75">Active Movies</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-receipt display-4"></i>
                <div>
                    <div class="fs-1 fw-bold lh-1">@Model.TotalOrders</div>
                    <div class="small opacity-75">Total Orders</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-danger text-white h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-currency-dollar display-4"></i>
                <div>
                    <div class="fs-1 fw-bold lh-1">RM @Model.TotalRevenue.ToString("N0")</div>
                    <div class="small opacity-75">Total Revenue</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Quick Actions</h5>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/Admin/Movies/Create" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i>Add Movie</a>
                    <a href="/Admin/Categories/Create" class="btn btn-outline-secondary"><i class="bi bi-plus-circle me-1"></i>Add Category</a>
                    <a href="/Admin/Showtimes/Create" class="btn btn-outline-primary"><i class="bi bi-plus-circle me-1"></i>Add Showtime</a>
                    <a href="/Admin/Orders?status=Pending" class="btn btn-outline-danger">
                        <i class="bi bi-exclamation-circle me-1"></i>Pending Orders (@Model.PendingOrders)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Recent Orders</h5>
        <a href="/Admin/Orders" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr><th>Order #</th><th>Customer</th><th>Date</th><th class="text-end">Amount</th><th class="text-center">Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.User?.FullName<br/><small class="text-muted">@order.ContactEmail</small></td>
                            <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">RM @order.TotalAmount.ToString("F2")</td>
                            <td class="text-center">
                                <span class="badge @(order.Status == CinemaBookingSystem.Models.OrderStatus.Completed ? "bg-success" :
                                                     order.Status == CinemaBookingSystem.Models.OrderStatus.Confirmed ? "bg-primary" :
                                                     order.Status == CinemaBookingSystem.Models.OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                    @order.Status
                                </span>
                            </td>
                            <td><a href="/Admin/Orders/Detail/@order.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
