@model IEnumerable<CinemaBookingSystem.Models.Movie>
@{
    ViewData["Title"] = "Movie Management";
    Layout = "_AdminLayout";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-film me-2 text-primary"></i>Movie Management</h2>
    <a asp-action="Create" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i>Add Movie</a>
</div>

<!-- Search -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group" style="max-width:400px">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search title or director..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle table-hover">
                <thead class="table-dark">
                    <tr>
                        <th width="60">Poster</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(movie.ImagePath))
                                {
                                    <img src="@movie.ImagePath" alt="@movie.Title"
                                         class="rounded" style="width:45px;height:60px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                         style="width:45px;height:60px;">
                                        <i class="bi bi-film text-white"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@movie.Title</div>
                                <small class="text-muted">@movie.Genre &nbsp;|&nbsp; @movie.Rating</small>
                            </td>
                            <td><span class="badge bg-primary">@movie.Category?.Name</span></td>
                            <td>@movie.Duration min</td>
                            <td class="text-end">RM @movie.Price.ToString("F2")</td>
                            <td class="text-center">
                                <span class="badge @(movie.IsActive ? "bg-success" : "bg-secondary")">@(movie.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@movie.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="ToggleStatus" asp-route-id="@movie.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(movie.IsActive ? "warning" : "success")" title="Toggle">
                                            <i class="bi bi-toggle-@(movie.IsActive ? "on" : "off")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No movies found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer d-flex justify-content-center">
            <nav>
                <ul class="pagination mb-0">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
