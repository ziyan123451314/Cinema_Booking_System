@model CinemaBookingSystem.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_Layout";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 me-2 text-primary"></i>Shopping Cart</h2>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <p class="mt-3 text-muted fs-5">Your cart is empty.</p>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-warning mt-2">
                <i class="bi bi-film me-2"></i>Browse Movies
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Movie / Showtime</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@item.Showtime?.Movie?.Title</div>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>@item.Showtime?.ShowDate.ToString("dd MMM yyyy")
                                                    &nbsp;<i class="bi bi-clock me-1"></i>@item.Showtime?.ShowTime.ToString(@"hh\:mm")
                                                    &nbsp;<i class="bi bi-building me-1"></i>@item.Showtime?.Hall
                                                </small>
                                            </td>
                                            <td class="text-center">RM @item.UnitPrice.ToString("F2")</td>
                                            <td class="text-center" style="width:140px">
                                                <form asp-action="Update" method="post" class="d-flex gap-1 justify-content-center">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <select name="quantity" class="form-select form-select-sm" style="width:70px" onchange="this.form.submit()">
                                                        @for (int q = 1; q <= Math.Min(item.Showtime?.AvailableSeats + item.Quantity ?? 10, 10); q++)
                                                        {
                                                            <option value="@q" selected="@(q == item.Quantity)">@q</option>
                                                        }
                                                    </select>
                                                </form>
                                            </td>
                                            <td class="text-end fw-bold">RM @item.SubTotal.ToString("F2")</td>
                                            <td class="text-end">
                                                <form asp-action="Remove" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items (@Model.Cart?.ItemCount)</span>
                            <span>RM @Model.Cart?.Total.ToString("F2")</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span class="text-primary">RM @Model.Cart?.Total.ToString("F2")</span>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-warning w-100 fw-semibold py-2">
                            <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
